{
  "name": "carl-gateway",
  "version": "0.3.0",
  "description": "Carl: a small, fast bot gateway for AI agents. Telegram, Slack, Discord, a web app, an OpenAI-compatible API and schedules, with a kernel sandbox and a self-reflecting psyche.",
  "keywords": [
    "agent",
    "ai",
    "bot",
    "gateway",
    "telegram",
    "slack",
    "discord",
    "claude",
    "codex",
    "mcp",
    "sandbox"
  ],
  "homepage": "https://github.com/michael-berardi/carl#readme",
  "bugs": {
    "url": "https://github.com/michael-berardi/carl/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/michael-berardi/carl.git"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "carl": "bin/carl"
  },
  "files": [
    "bin",
    "src",
    "vendor",
    "scripts",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "node --experimental-strip-types --no-warnings --test 'test/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm test",
    "test:e2e": "node --experimental-strip-types --no-warnings test/e2e.ts"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.0.4"
  },
  "devDependencies": {
    "@types/node": "22.15.21",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@earendil-works/pi-ai": "1.0.4",
    "@earendil-works/pi-agent-core": "1.0.4",
    "@earendil-works/pi-mcp": "1.0.4",
    "@earendil-works/pi-codemode": "1.0.4",
    "@earendil-works/pi-tui": "1.0.4",
    "@earendil-works/chord": "1.0.4",
    "@earendil-works/pi-telemetry": "1.0.4"
  }
}
